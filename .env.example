# ===== Instagram (obrigatório) =====
# Token de acesso do Instagram (veja o README)
IG_ACCESS_TOKEN=
# ID da conta do Instagram; "me" funciona com login do Instagram
IG_USER_ID=me
# Endereço público onde o app está hospedado (ex.: https://meu-app.onrender.com)
PUBLIC_BASE_URL=
# graph.instagram.com (login do Instagram) ou graph.facebook.com (login do Facebook)
GRAPH_HOST=graph.instagram.com
GRAPH_API_VERSION=v23.0
# Legenda usada quando nenhuma for enviada (opcional)
DEFAULT_CAPTION=

# ===== Bot do WhatsApp (deixe vazio para desligar) =====
# Token permanente do WhatsApp Cloud API (usuário do sistema no Business Manager)
WA_ACCESS_TOKEN=
# "Phone number ID" mostrado em WhatsApp > API Setup
WA_PHONE_NUMBER_ID=
# Uma senha qualquer que você inventa e repete na tela de configuração do webhook
WA_VERIFY_TOKEN=
# "App secret" em App settings > Basic (garante que as mensagens vêm mesmo da Meta)
WA_APP_SECRET=
# Números que podem publicar, com DDI e DDD, separados por vírgula
WA_ALLOWED_NUMBERS=5511999999999
# Segundos esperando mais fotos/legenda antes de publicar
WA_ALBUM_WAIT_SECONDS=15

# ===== Site (opcional; deixe vazio para desligar) =====
APP_PASSWORD=

# ===== Marca d'água (opcional) =====
# Coloque a logo como watermark.png na raiz do projeto para ativar.
# Posição: bottom-right, bottom-left, top-right, top-left ou center
WATERMARK_POSITION=bottom-right
# Largura da logo em relação à foto (0.2 = 20%)
WATERMARK_SIZE=0.2
# Transparência da logo (1 = sem transparência)
WATERMARK_OPACITY=0.8

# true = testa tudo sem publicar de verdade
DRY_RUN=false
PORT=3000
